# =========================================
# BioSeqLab v.1.0
# DNA Sequence Analyzer
# =========================================


def validate_dna(sequence):
    """Check if DNA sequence contains only A, T, G and C."""

    if len(sequence) == 0:
        return False

    sequence = sequence.upper()

    for nucleotide in sequence:
        if nucleotide not in "ATGC":
            return False

    return True


def nucleotide_count(sequence):
    """Count A, T, G and C."""

    counts = {
        "A": 0,
        "T": 0,
        "G": 0,
        "C": 0
    }

    for nucleotide in sequence:
        counts[nucleotide] += 1

    return counts


def gc_content(sequence):
    """Calculate GC percentage."""

    counts = nucleotide_count(sequence)

    gc = counts["G"] + counts["C"]

    return (gc / len(sequence)) * 100


def nucleotide_percentage(sequence):
    """Calculate nucleotide percentages."""

    counts = nucleotide_count(sequence)

    percentages = {}

    for nucleotide in "ATGC":
        percentages[nucleotide] = (
            counts[nucleotide] / len(sequence)
        ) * 100

    return percentages


def reverse_complement(sequence):
    """Generate reverse complement."""

    complement = {
        "A": "T",
        "T": "A",
        "G": "C",
        "C": "G"
    }

    reverse = sequence[::-1]

    result = ""

    for nucleotide in reverse:
        result += complement[nucleotide]

    return result


def codon_finder(sequence):
    """Split DNA into codons."""

    codons = []

    for i in range(0, len(sequence), 3):

        codon = sequence[i:i + 3]

        if len(codon) == 3:
            codons.append(codon)

    return codons


def find_start_codons(sequence):
    """Find every ATG."""

    positions = []

    for i in range(len(sequence) - 2):

        if sequence[i:i + 3] == "ATG":
            positions.append(i)

    return positions


def find_stop_codons(sequence):
    """Find stop codons."""

    stop_codons = (
        "TAA",
        "TAG",
        "TGA"
    )

    found = []

    for i in range(len(sequence) - 2):

        codon = sequence[i:i + 3]

        if codon in stop_codons:
            found.append((codon, i))

    return found


def analyze(sequence):

    print("\n========== RESULT ==========\n")

    print("Sequence :", sequence)
    print("Length   :", len(sequence))

    counts = nucleotide_count(sequence)

    print("\nNucleotide Count")

    for nucleotide in "ATGC":
        print(f"{nucleotide} : {counts[nucleotide]}")

    print(f"\nGC Content : {gc_content(sequence):.2f}%")

    percentages = nucleotide_percentage(sequence)

    print("\nNucleotide Percentage")

    for nucleotide in "ATGC":
        print(f"{nucleotide} : {percentages[nucleotide]:.2f}%")

    print("\nReverse Complement")

    print(reverse_complement(sequence))

    print("\nCodons")

    codons = codon_finder(sequence)

    if len(codons) == 0:
        print("No complete codons found.")

    else:
        for codon in codons:
            print(codon)

    starts = find_start_codons(sequence)

    if starts:

        print("\nStart Codon (ATG)")

        for position in starts:
            print("Found at position", position)

    else:
        print("\nNo Start Codon Found.")

    stops = find_stop_codons(sequence)

    if stops:

        print("\nStop Codons")

        for codon, position in stops:
            print(codon, "at position", position)

    else:
        print("\nNo Stop Codon Found.")

    print("\n========== SUMMARY ==========")

    print("Valid DNA  : YES")
    print("Length     :", len(sequence))
    print(f"GC Content : {gc_content(sequence):.2f}%")

    if starts:
        print("Start Codon: YES")
    else:
        print("Start Codon: NO")

    if stops:
        print("Stop Codon : YES")
    else:
        print("Stop Codon : NO")

    print("=============================\n")


def menu():

    while True:

        print("===================================")
      print("         BioSeqLab v.1.0")
        print("      DNA Sequence Analyzer")
        print("===================================")

        print("1. Analyze DNA")
        print("2. Exit")

        choice = input("\nSelect: ")

        if choice == "1":

            sequence = input("\nEnter DNA Sequence: ").upper().strip()

            if validate_dna(sequence):
                analyze(sequence)

            else:
                print("\nInvalid DNA Sequence!")
                print("Only A, T, G and C are allowed.\n")

        elif choice == "2":

            print("\nThank you for using BioSeqLab.")
            break

        else:

            print("\nInvalid Choice.\n")


if __name__ == "__main__":
    menu()
    
